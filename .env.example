# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Cisco C1111 SSH ---
ROUTER_HOST=192.168.x.x
ROUTER_SSH_USER=admin
ROUTER_SSH_PASSWORD=changeme

# --- Cisco C1111 WebUI ---
ROUTER_WEBUI_USER=admin
ROUTER_WEBUI_PASSWORD=changeme
ROUTER_WEBUI_BASE_URL=https://192.168.x.x

# --- Playwright VLAN probe (script 06) ---
# Set PLAYWRIGHT_DRY_RUN=false to actually commit the VLAN to the router.
PLAYWRIGHT_DRY_RUN=true
VLAN_ID=99
VLAN_NAME=TEST-PLAYWRIGHT

# --- App ---
LOG_LEVEL=INFO
ARTIFACTS_DIR=artifacts
LOGS_DIR=logs
